---
---
<div class="rounded-lg border border-[var(--border-color)] p-5">
  <h2 class="text-xl font-semibold mb-4">站点信息</h2>
  <div class="flex gap-3 mb-3">
    <button id="load-site-info-btn" class="rounded border border-[var(--border-color)] px-4 py-2 hover:bg-[var(--hover-bg-color)]">加载</button>
    <button id="save-site-info-btn" class="rounded border border-[var(--border-color)] px-4 py-2 hover:bg-[var(--hover-bg-color)]">保存</button>
  </div>
  <div class="space-y-3">
    <div>
      <label class="block text-sm mb-1">站点标题（左上角 Logo 文字）</label>
      <input id="site-info-title" type="text" class="w-full rounded border border-[var(--border-color)] bg-transparent px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1">网站标语（标题下方）</label>
      <input id="site-info-slogan" type="text" class="w-full rounded border border-[var(--border-color)] bg-transparent px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1">创建时间（运行天数起始，格式 YYYY-MM-DD）</label>
      <input id="site-info-created-at" type="text" placeholder="2026-02-12" class="w-full rounded border border-[var(--border-color)] bg-transparent px-3 py-2" />
    </div>
  </div>
  <p id="site-info-msg" class="text-sm mt-3 text-[var(--text-color)]/70"></p>
</div>
