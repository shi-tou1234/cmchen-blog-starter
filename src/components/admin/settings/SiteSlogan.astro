---
---
<div class="rounded-lg border border-[var(--border-color)] p-5">
  <h2 class="text-xl font-semibold mb-4">网站标语</h2>
  <div class="flex gap-3 mb-3">
    <button id="load-site-slogan-btn" class="rounded border border-[var(--border-color)] px-4 py-2 hover:bg-[var(--hover-bg-color)]">加载</button>
    <button id="save-site-slogan-btn" class="rounded border border-[var(--border-color)] px-4 py-2 hover:bg-[var(--hover-bg-color)]">保存</button>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div>
      <label class="block text-sm mb-1">中文标语</label>
      <input id="site-slogan-zh" type="text" class="w-full rounded border border-[var(--border-color)] bg-transparent px-3 py-2" />
    </div>
    <div>
      <label class="block text-sm mb-1">English Slogan</label>
      <input id="site-slogan-en" type="text" class="w-full rounded border border-[var(--border-color)] bg-transparent px-3 py-2" />
    </div>
  </div>
  <p id="site-slogan-msg" class="text-sm mt-3 text-[var(--text-color)]/70"></p>
</div>
