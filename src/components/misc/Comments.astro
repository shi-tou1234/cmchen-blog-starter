---
import { externalUrlsConfig } from "../../config";
// Giscus 评论系统组件（基于 GitHub Discussions，无需后端）
// 使用官方原生 <script> 标签写法，最大限度排除 Astro 脚本处理带来的干扰。
// data-astro-rerun 保证 Astro View Transitions 切换页面后该脚本会重新执行。
---

<section id="comments" class="giscus-comments mt-12 pt-8 border-t border-[var(--border-color)] scroll-mt-24" aria-label="评论">
  <h2 class="giscus-title text-2xl font-bold text-[var(--text-color)] mb-4 flex items-center gap-2">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
    </svg>
    <span>评论</span>
  </h2>
  <div class="giscus-wrap">
    <div class="giscus"></div>
    <div class="giscus-status" data-giscus-status aria-live="polite">
      <div class="giscus-status__loading">
        <span class="giscus-status__spinner" aria-hidden="true"></span>
        <span>评论加载中…</span>
      </div>
      <div class="giscus-status__error">
        <p>评论加载失败，可能是网络原因。</p>
        <button type="button" class="giscus-status__retry" data-giscus-retry>重新加载</button>
      </div>
    </div>
  </div>
</section>

<script
  src="https://giscus.app/client.js"
  data-repo={externalUrlsConfig.githubRepo}
  data-repo-id={externalUrlsConfig.giscusRepoId}
  data-category="General"
  data-category-id="DIC_kwDORRKvYM4DAamD"
  data-mapping="pathname"
  data-strict="0"
  data-reactions-enabled="1"
  data-emit-metadata="0"
  data-input-position="top"
  data-theme="light"
  data-lang="zh-CN"
  crossorigin="anonymous"
  async
  is:inline
  data-astro-rerun
></script>

<script is:inline>
(function() {
  var GISCUS_TIMEOUT = 15000;

  function getGiscusTheme() {
    var theme = document.documentElement.getAttribute('data-theme');
    if (theme === 'dark') return 'dark';
    if (theme) return 'light';
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function getGiscusThemeName() {
    var theme = document.documentElement.getAttribute('data-theme');
    if (theme === 'dark') return 'dark_dimmed';
    return 'light';
  }

  function setGiscusTheme(theme) {
    var iframe = document.querySelector('iframe.giscus-frame');
    if (!iframe) return;
    iframe.contentWindow.postMessage({
      giscus: { setConfig: { theme: theme } }
    }, 'https://giscus.app');
  }

  function initGiscusThemeSync() {
    // Set initial theme on the script tag before Giscus loads
    var script = document.querySelector('script[src="https://giscus.app/client.js"]');
    if (script) {
      script.setAttribute('data-theme', getGiscusThemeName());
    }

    // Observe theme changes
    var observer = new MutationObserver(function(mutations) {
      mutations.forEach(function(m) {
        if (m.attributeName === 'data-theme') {
          setGiscusTheme(getGiscusThemeName());
        }
      });
    });
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }

  // ========== 评论加载状态：加载中提示 / 失败提示与重试 ==========
  function clearGiscusStatusTimer() {
    if (window.__giscusStatusTimer) {
      clearTimeout(window.__giscusStatusTimer);
      window.__giscusStatusTimer = null;
    }
  }

  function initGiscusStatus() {
    var wrap = document.querySelector('.giscus-comments');
    if (!wrap) return;
    var container = wrap.querySelector('.giscus');
    var status = wrap.querySelector('[data-giscus-status]');
    var retryBtn = wrap.querySelector('[data-giscus-retry]');
    if (!container || !status) return;

    clearGiscusStatusTimer();
    if (window.__giscusStatusObserver) {
      window.__giscusStatusObserver.disconnect();
      window.__giscusStatusObserver = null;
    }

    var markLoaded = function() {
      clearGiscusStatusTimer();
      if (window.__giscusStatusObserver) {
        window.__giscusStatusObserver.disconnect();
        window.__giscusStatusObserver = null;
      }
      status.classList.add('is-loaded');
      status.classList.remove('is-error');
    };

    status.classList.remove('is-loaded', 'is-error');

    var watchIframe = function(iframe) {
      if (!iframe || iframe.dataset.giscusLoaded === 'true') {
        if (iframe) markLoaded();
        return;
      }
      iframe.addEventListener('load', function() {
        iframe.dataset.giscusLoaded = 'true';
        markLoaded();
      });
    };

    var iframe = container.querySelector('iframe.giscus-frame');
    watchIframe(iframe);

    var observer = new MutationObserver(function() {
      var next = container.querySelector('iframe.giscus-frame');
      if (next) watchIframe(next);
    });
    observer.observe(container, { childList: true, subtree: true });
    window.__giscusStatusObserver = observer;

    window.__giscusStatusTimer = setTimeout(function() {
      var current = container.querySelector('iframe.giscus-frame');
      if (!current || current.dataset.giscusLoaded !== 'true') {
        status.classList.add('is-error');
      }
    }, GISCUS_TIMEOUT);

    if (retryBtn && retryBtn.dataset.bound !== 'true') {
      retryBtn.dataset.bound = 'true';
      retryBtn.addEventListener('click', function() {
        container.innerHTML = '';
        var script = document.querySelector('script[src="https://giscus.app/client.js"]');
        if (script) {
          var clone = script.cloneNode(true);
          script.remove();
          document.body.appendChild(clone);
        }
        initGiscusStatus();
      });
    }
  }

  document.addEventListener('astro:page-load', initGiscusThemeSync);
  document.addEventListener('astro:page-load', initGiscusStatus);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGiscusThemeSync);
    document.addEventListener('DOMContentLoaded', initGiscusStatus);
  } else {
    initGiscusThemeSync();
    initGiscusStatus();
  }
})();
</script>

<style is:global>
  .giscus-comments {
    max-width: 100%;
  }

  .giscus-wrap {
    position: relative;
  }

  .giscus {
    min-height: 12rem;
  }

  .giscus iframe.giscus-frame {
    width: 100%;
    border: none;
    color-scheme: light dark;
  }

  .giscus-status {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 3rem;
    background: var(--bg-color);
    transition: opacity 0.3s ease;
  }

  .giscus-status.is-loaded {
    opacity: 0;
    pointer-events: none;
  }

  .giscus-status__loading {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--muted-text-color);
    font-size: 0.9rem;
  }

  .giscus-status__spinner {
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 50%;
    border: 2px solid color-mix(in srgb, var(--link-color) 35%, transparent);
    border-top-color: var(--link-color);
    animation: giscus-status-spin 0.8s linear infinite;
  }

  @keyframes giscus-status-spin {
    to { transform: rotate(360deg); }
  }

  .giscus-status__error {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: var(--muted-text-color);
    font-size: 0.9rem;
    text-align: center;
  }

  .giscus-status.is-error .giscus-status__loading {
    display: none;
  }

  .giscus-status.is-error .giscus-status__error {
    display: flex;
  }

  .giscus-status__retry {
    border: 1px solid var(--border-color);
    border-radius: 999px;
    background: var(--hover-bg-color);
    color: var(--text-color);
    padding: 0.35rem 0.9rem;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .giscus-status__retry:hover {
    border-color: color-mix(in srgb, var(--link-color) 45%, var(--border-color));
    color: var(--link-color);
  }

  @media (prefers-reduced-motion: reduce) {
    .giscus-status__spinner {
      animation: none;
    }
  }
</style>
