---
import { baseUrl, getRelativeLocaleUrl } from "@utils/url-utils";
import { getEntry, render } from 'astro:content'
import i18nit from "@i18n/translation";
import "../../styles/motion.css"
import { PRESS } from "@utils/press";

interface SearchResult {
  url: string;
  meta: {
    title: string;
  };
  excerpt: string;
}



const currentLang = 'zh-cn';
const t = i18nit(currentLang);

const translations = {
  placeholder: t("search.placeholder"),
  searching: t("search.searching"),
  error: t("search.error"),
  noresult: t("search.noresult"),
  noresultHint: '换个关键词试试，或减少一些字词',
  browseArchives: '浏览全部归档'
};

const archivesUrl = getRelativeLocaleUrl(currentLang, '/archives/');

const searchHistoryKey = 'cmchen_search_history_v1';
const searchRecommendationsTitle = '推荐搜索';
const searchRecentLabel = '最近搜索';
const searchHotLabel = '热门搜索';
const searchClearLabel = '清空';
const searchEmptyHistoryLabel = '暂无搜索记录';
const hotSearches = ['AI 工具', '学习笔记', '归档', '博客指南', '生活记录'];

// 开发环境没有 pagefind 索引（dev 下不构建索引），用占位结果演示界面
const isDevBuild = import.meta.env.DEV;

// 结果条数上限：pagefind 对每个结果都要单独取一次片段，
// 命中很多时全量取数会明显拖慢（移动端尤其），只取前面这些
const maxResults = 12;

const fakeResult: SearchResult[] = [
	{
		url: baseUrl("/"),
		meta: {
			title: "This Is a Fake Search Result",
		},
		excerpt:
			"Because the search cannot work in the <mark>dev</mark> environment.",
	},
	{
		url: baseUrl("/"),
		meta: {
			title: "If You Want to Test the Search",
		},
		excerpt: "Try running <mark>pnpm build && pnpm preview</mark> instead.",
  }
]
---
<div id="search-modal" class="fixed inset-0 z-[var(--z-search)] opacity-0 pointer-events-none anim-fade-out" role="dialog" aria-modal="true" aria-labelledby="search-dialog-title" aria-hidden="true">
  <div class="absolute inset-0 modal-backdrop opacity-0" aria-hidden="true"></div>

  <div class="search-modal-shell fixed inset-0 flex items-start justify-center p-4 pt-[25vh]">
    <div class="search-modal-content bg-[var(--bg-color)] rounded-xl shadow-xl w-full max-w-2xl border border-[var(--border-color)] overflow-hidden scale-80 transition-all duration-300 opacity-0 flex flex-col max-h-[40vh]">
      <h2 id="search-dialog-title" class="sr-only">{t("search.placeholder")}</h2>
      <div class="flex items-center p-4 border-b border-[var(--border-color)]">
        <div class="search-modal-input-wrap relative flex items-center flex-1">
          <svg class="search-modal-icon absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-[var(--cover-subtitle-color)] transition-colors duration-300 pointer-events-none z-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>
          <input 
            type="text" 
            id="search-input"
            placeholder={t("search.placeholder")+"..."}
            class="search-modal-input w-full bg-transparent border border-[var(--border-color)] rounded-full py-3 pl-10 pr-4 text-[var(--text-color)] outline-none transition-all duration-300"
            autocomplete="off"
            enterkeyhint="search"
          />
        </div>
        <button id="close-search" class={`ml-2 p-2 text-[var(--cover-subtitle-color)] rounded-lg hover:bg-[var(--hover-bg-color)] ${PRESS}`}>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      <div class="search-modal-body flex-1 min-h-0 overflow-y-auto overscroll-contain">
        <div id="search-recommendations" class="hidden border-b border-[var(--border-color)] bg-[var(--hover-bg-color)]/20 px-4 py-3 text-sm text-[var(--cover-subtitle-color)]"></div>
        <div id="search-results">
          <div class="p-8 text-center text-[var(--cover-subtitle-color)]">
            <p>{t("search.placeholder")}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
import { lockBodyScroll } from "../../utils/modal";

function initSearchModal() {
  const searchButton = document.getElementById('search-button');
  const searchModal = document.getElementById('search-modal');
  const closeSearch = document.getElementById('close-search');
  const searchInput = document.getElementById('search-input');
  const modalBackdrop = searchModal?.firstElementChild;
  const modalContent = searchModal?.querySelector('.search-modal-content');

  if (!searchButton || !searchModal) return;
  if (searchModal.dataset.bound === 'true') return;
  searchModal.dataset.bound = 'true';

  let previousFocusedElement: HTMLElement | null = null;

  const isModalOpen = () => !searchModal.classList.contains('opacity-0');

  // 移动端键盘弹出时 visualViewport 会缩小（layout viewport 与 vh 不变），
  // 面板的贴顶位置与限高依赖这两个变量，否则底部内容会被键盘盖住
  const syncSearchViewport = () => {
    const viewport = window.visualViewport;
    const height = viewport ? viewport.height : window.innerHeight;
    const offsetTop = viewport ? viewport.offsetTop : 0;
    searchModal.style.setProperty('--search-vvh', `${Math.round(height)}px`);
    searchModal.style.setProperty('--search-vv-top', `${Math.round(offsetTop)}px`);
  };

  const visualViewport = window.visualViewport;
  const oldViewportHandler = (window as any).__searchViewportHandler;
  if (visualViewport && oldViewportHandler) {
    visualViewport.removeEventListener('resize', oldViewportHandler);
    visualViewport.removeEventListener('scroll', oldViewportHandler);
  }
  if (visualViewport) {
    visualViewport.addEventListener('resize', syncSearchViewport);
    visualViewport.addEventListener('scroll', syncSearchViewport);
    (window as any).__searchViewportHandler = syncSearchViewport;
  }
  syncSearchViewport();

  const getFocusableElements = () => {
    if (!modalContent) return [];
    return Array.from(
      modalContent.querySelectorAll('a[href], button:not([disabled]), textarea:not([disabled]), input:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])')
    );
  };

  const shouldIgnoreShortcut = (target: EventTarget | null) => {
    if (!target) return false;
    const tag = (target as Element).tagName;
    return (target as HTMLElement).isContentEditable || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT';
  };

  // 移动端浮动按钮层级高于搜索浮层，不收起会压住面板右上角、挡掉结果行的点击
  const setFabHidden = (hidden: boolean) => {
    const fab = document.getElementById('mobile-fab');
    const fabTrigger = document.getElementById('mobile-fab-trigger');
    if (!fab) return;
    // 展开状态先走 FAB 自己的收起逻辑，避免关闭搜索后它带着展开面板回来
    if (hidden && fab.offsetParent !== null && fab.classList.contains('is-active') && fabTrigger) {
      fabTrigger.click();
    }
    fab.classList.toggle('is-search-open', hidden);
  };

  const openModal = () => {
    // 用户首次打开搜索面板时按需加载 pagefind 索引
    (window as any).__loadPagefindNow?.();
    syncSearchViewport();
    setFabHidden(true);
    previousFocusedElement = document.activeElement as HTMLElement | null;
    lockBodyScroll(true);
    searchModal.classList.remove('opacity-0', 'pointer-events-none');
    searchModal.setAttribute('aria-hidden', 'false');
    void searchModal.offsetHeight; // 强制回流，确保过渡动画生效
    requestAnimationFrame(() => {
      modalBackdrop?.classList.remove('opacity-0');
      modalBackdrop?.classList.add('show');
      modalContent?.classList.remove('scale-80', 'opacity-0');
      modalContent?.classList.add('scale-100');
    });
    setTimeout(() => searchInput?.focus({ preventScroll: true }), 300);
    (window as any).__renderSearchRecommendations?.();
  };

  const closeModal = () => {
    lockBodyScroll(false);
    setFabHidden(false);
    requestAnimationFrame(() => {
      modalBackdrop?.classList.add('opacity-0');
      modalBackdrop?.classList.remove('show');
      modalContent?.classList.add('scale-80', 'opacity-0');
      modalContent?.classList.remove('scale-100');
    });
    setTimeout(() => {
      searchModal.classList.add('opacity-0', 'pointer-events-none');
      searchModal.setAttribute('aria-hidden', 'true');
      if (previousFocusedElement instanceof HTMLElement) {
        previousFocusedElement.focus();
      }
    }, 300);
  };

  searchButton.addEventListener('click', openModal);
  closeSearch?.addEventListener('click', closeModal);
  (window as any).__closeSearchModal = closeModal;
  searchModal.addEventListener('click', (e) => {
    if (!modalContent?.contains(e.target as Node)) closeModal();
  });
  const oldKeydownHandler = (window as any).__searchModalKeydownHandler;
  if (oldKeydownHandler) {
    document.removeEventListener('keydown', oldKeydownHandler);
  }

  const handleKeydown = (e: KeyboardEvent) => {
    if (e.key === 'Escape' && isModalOpen()) {
      closeModal();
      return;
    }

    if (isModalOpen() && e.key === 'Tab') {
      const focusableElements = getFocusableElements();
      if (focusableElements.length === 0) return;

      const firstElement = focusableElements[0] as HTMLElement;
      const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;
      const active = document.activeElement as HTMLElement | null;

      if (e.shiftKey && active === firstElement) {
        e.preventDefault();
        lastElement.focus();
      } else if (!e.shiftKey && active === lastElement) {
        e.preventDefault();
        firstElement.focus();
      }
      return;
    }

    const target = e.target;
    if (!isModalOpen() && !e.altKey && !e.shiftKey && !e.ctrlKey && !e.metaKey && e.key === '/' && !shouldIgnoreShortcut(target)) {
      e.preventDefault();
      openModal();
      return;
    }

    if (!isModalOpen() && (e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      openModal();
    }
  };

  document.addEventListener('keydown', handleKeydown);
  (window as any).__searchModalKeydownHandler = handleKeydown;
}

document.addEventListener('DOMContentLoaded', initSearchModal);
document.addEventListener('astro:after-swap', initSearchModal);
</script>


<style>
  @keyframes backdropFadeIn {
    0% {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
    100% {
      opacity: 1;
      backdrop-filter: blur(2px);
    }
  }
  
  @keyframes backdropFadeOut {
    0% {
      opacity: 1;
      backdrop-filter: blur(2px);
    }
    100% {
      opacity: 0;
      backdrop-filter: blur(0px);
    }
  }
  
  .modal-backdrop {
    background-color: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(0px);
    transition: opacity 0.3s ease-out;
  }
  
  .modal-backdrop.show {
    animation: backdropFadeIn 0.3s ease-out forwards;
  }
  
  .modal-backdrop:not(.show) {
    animation: backdropFadeOut 0.3s ease-out forwards;
  }
  
  #search-input::-webkit-input-placeholder {
    color: var(--cover-subtitle-color);
  }
  
  #search-input::-moz-placeholder {
    color: var(--cover-subtitle-color);
  }

  .search-modal-input {
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .search-modal-input:focus {
    border-color: var(--link-color);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--link-color) 25%, transparent);
  }

  .search-modal-input-wrap:focus-within .search-modal-icon {
    color: var(--link-color);
  }

  /* 移动端：面板贴住可见区顶部，高度不超出键盘以上的区域。
     --search-vvh / --search-vv-top 由脚本按 visualViewport 写入：
     键盘弹出时 layout viewport 不变（vh 也不变），只有 visualViewport 缩小，
     所以高度必须走 JS 变量，不能只靠 vh/dvh。 */
  @media (max-width: 640px) {
    #search-modal .search-modal-shell {
      padding-top: calc(var(--search-vv-top, 0px) + env(safe-area-inset-top, 0px) + 0.5rem);
    }

    #search-modal .search-modal-content {
      max-height: calc(var(--search-vvh, 100dvh) - 1rem);
    }
  }
</style>

<script define:vars={{ fakeResult, translations, archivesUrl, searchHistoryKey, searchRecommendationsTitle, searchRecentLabel, searchHotLabel, searchClearLabel, searchEmptyHistoryLabel, hotSearches, isDevBuild, maxResults }}>
let searchRequestId = 0;
window.__searchDebounceTimer = null;

function renderSearchStatus(message, extraClass = '') {
  const searchResults = document.getElementById('search-results');
  if (!searchResults) return;

  const className = extraClass ? ` ${extraClass}` : '';
  searchResults.innerHTML = `
    <div class="p-8 text-center text-[var(--cover-subtitle-color)]${className}">
      <p>${message}</p>
    </div>
  `;
}

function escapeHtml(text) {
  return String(text)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function getSearchHistory() {
  try {
    const parsed = JSON.parse(localStorage.getItem(searchHistoryKey) || '[]');
    return Array.isArray(parsed) ? parsed.filter(Boolean) : [];
  } catch {
    return [];
  }
}

function saveSearchHistory(query) {
  const normalized = String(query || '').trim();
  if (!normalized) return;

  const nextHistory = [normalized, ...getSearchHistory().filter((item) => item !== normalized)].slice(0, 6);
  try {
    localStorage.setItem(searchHistoryKey, JSON.stringify(nextHistory));
  } catch (_error) {
    // ignore storage errors
  }
}

function renderSearchRecommendations() {
  const recommendations = document.getElementById('search-recommendations');
  if (!recommendations) return;

  const history = getSearchHistory();
  const recentItems = history.slice(0, 6);
  const fallbackItems = hotSearches.filter((item) => !recentItems.includes(item));

  recommendations.innerHTML = `
    <div class="flex items-center justify-between gap-3">
      <div class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--cover-subtitle-color)]">${searchRecommendationsTitle}</div>
      ${history.length > 0 ? `<button type="button" data-search-clear-history class="text-xs text-[var(--cover-subtitle-color)] hover:text-[var(--text-color)]">${searchClearLabel}</button>` : ''}
    </div>
    <div class="mt-2 space-y-2">
      <div class="flex items-center gap-2 text-xs text-[var(--cover-subtitle-color)]/80">
        <span>${searchRecentLabel}</span>
        ${history.length === 0 ? `<span>· ${searchEmptyHistoryLabel}</span>` : ''}
      </div>
      <div class="flex flex-wrap gap-2">
        ${recentItems.map((item) => `<button type="button" class="search-suggestion-chip" data-search-suggestion="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join('')}
      </div>
    </div>
    <div class="mt-3 space-y-2">
      <div class="flex items-center gap-2 text-xs text-[var(--cover-subtitle-color)]/80">
        <span>${searchHotLabel}</span>
      </div>
      <div class="flex flex-wrap gap-2">
        ${fallbackItems.map((item) => `<button type="button" class="search-suggestion-chip" data-search-suggestion="${escapeHtml(item)}">${escapeHtml(item)}</button>`).join('')}
      </div>
    </div>
  `;

  recommendations.classList.remove('hidden');

  if (recommendations.dataset.bound === 'true') return;
  recommendations.dataset.bound = 'true';

  recommendations.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof HTMLElement)) return;

    const clearButton = target.closest('[data-search-clear-history]');
    if (clearButton) {
      try {
        localStorage.removeItem(searchHistoryKey);
      } catch (_error) {
        // ignore storage errors
      }
      renderSearchRecommendations();
      return;
    }

    const suggestion = target.closest('[data-search-suggestion]');
    if (!suggestion) return;

    const query = suggestion.getAttribute('data-search-suggestion') || '';
    const searchInput = document.getElementById('search-input');
    if (searchInput instanceof HTMLInputElement) {
      searchInput.value = query;
      searchInput.dispatchEvent(new Event('input', { bubbles: true }));
      searchInput.focus();
    }
  });

  window.__renderSearchRecommendations = renderSearchRecommendations;
}

const searchDebounceMs = 300;

function readSearchQuery() {
  const searchInput = document.getElementById('search-input');
  return searchInput instanceof HTMLInputElement ? searchInput.value.trim() : '';
}

function runScheduledSearch() {
  const query = readSearchQuery();
  if (query.length > 0) {
    performSearch(query);
  } else {
    renderSearchRecommendations();
    renderSearchStatus(translations.placeholder);
  }
}

function scheduleSearch(delay = searchDebounceMs) {
  clearTimeout(window.__searchDebounceTimer);
  window.__searchDebounceTimer = setTimeout(() => {
    window.__searchDebounceTimer = null;
    runScheduledSearch();
  }, delay);
}

function initPagefindSearch() {
  const searchInput = document.getElementById('search-input');
  const searchResults = document.getElementById('search-results');
  
  if (!searchInput || !searchResults) return;

  // 避免重复绑定
  if (searchInput.dataset.bound === 'true') return;
  searchInput.dataset.bound = 'true';

  // 清理上一页可能残留的防抖任务，并重置结果容器
  if (window.__searchDebounceTimer) {
    clearTimeout(window.__searchDebounceTimer);
    window.__searchDebounceTimer = null;
  }
  searchResults.innerHTML = `
    <div class="p-8 text-center text-[var(--cover-subtitle-color)]">
      <p>${translations.placeholder}</p>
    </div>
  `;

  searchInput.addEventListener('input', (event) => {
    // 中文输入法组合期间不搜：拼音串不是最终关键词，搜了既慢又没有意义
    if (event.isComposing) return;
    scheduleSearch();
  });

  // 输入法选词结束（组合期的 input 已被跳过）后补一次搜索
  searchInput.addEventListener('compositionend', () => scheduleSearch());

  // 回车立即搜，不等防抖（移动端软键盘的“搜索”键同样走这里）
  searchInput.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.isComposing) return;
    event.preventDefault();
    clearTimeout(window.__searchDebounceTimer);
    window.__searchDebounceTimer = null;
    runScheduledSearch();
  });
}

async function performSearch(query) {
  const requestId = ++searchRequestId;
  saveSearchHistory(query);
  document.getElementById('search-recommendations')?.classList.add('hidden');
  renderSearchStatus(translations.searching);

  if (isDevBuild) {
    // dev 环境没有 pagefind 索引，用占位结果演示界面
    if (requestId !== searchRequestId) return;
    displayResults(fakeResult);
    return;
  }

  // 首次搜索时索引可能还在按需加载：等它就绪，别当成搜不到
  const pagefindReady = window.__loadPagefindNow ? await window.__loadPagefindNow() : false;
  if (requestId !== searchRequestId) return;

  if (!pagefindReady || !window.pagefind) {
    renderSearchStatus('搜索索引加载失败，请检查网络后重试');
    return;
  }

  try {
    const searchResultsData = await window.pagefind.search(query);
    if (requestId !== searchRequestId) return;

    // pagefind 每个结果的片段都要单独取一次网络请求，
    // 并发取完再渲染，比逐个 await 快得多（结果多时差距尤其明显）
    const matched = searchResultsData.results.slice(0, maxResults);
    const datas = await Promise.all(matched.map((result) => result.data()));
    if (requestId !== searchRequestId) return;

    displayResults(datas.map((data) => ({
      url: data.url,
      meta: { title: data.meta.title },
      excerpt: data.excerpt
    })), searchResultsData.results.length);
  } catch (error) {
    if (requestId !== searchRequestId) return;
    console.error('Search failed:', error);
    renderSearchStatus(translations.error, ' text-red-500');
  }
}

function displayResults(results, totalCount = results.length) {
  const searchResults = document.getElementById('search-results');
  if (!searchResults) return;

  if (results.length === 0) {
    searchResults.innerHTML = `
      <div class="p-8 text-center text-[var(--cover-subtitle-color)]">
        <p class="text-base font-semibold text-[var(--text-color)]/85 mb-2">${translations.noresult}</p>
        <p class="text-sm mb-4">${translations.noresultHint}</p>
        <div class="flex items-center justify-center gap-2">
          <a href="${archivesUrl}" class="search-suggestion-chip no-underline" data-search-close>${translations.browseArchives}</a>
        </div>
      </div>
    `;
    return;
  }

  const hiddenCount = totalCount - results.length;
  searchResults.innerHTML = results.map(result => `
    <div class="p-4 border-b border-[var(--border-color)] hover:bg-[var(--hover-bg-color)]">
      <a href="${result.url}" class="block no-underline">
        <h3 class="text-lg font-semibold text-[var(--text-color)] mb-2">${result.meta.title}</h3>
        <p class="text-[var(--cover-subtitle-color)] text-sm">${result.excerpt}</p>
      </a>
    </div>
  `).join('') + (hiddenCount > 0 ? `
    <div class="p-3 text-center text-xs text-[var(--cover-subtitle-color)]">
      共 ${totalCount} 条结果，仅显示前 ${results.length} 条
    </div>
  ` : '');
}

// ========== 初始化逻辑 ==========
document.addEventListener('pagefindready', () => {
  // console.log('Pagefind is ready');
});
document.addEventListener('pagefindloaderror', () => {
  console.log('Pagefind failed to load, search functionality will not work');
});

document.addEventListener('DOMContentLoaded', initPagefindSearch);
document.addEventListener('astro:after-swap', initPagefindSearch);
document.addEventListener('DOMContentLoaded', renderSearchRecommendations);
document.addEventListener('astro:after-swap', renderSearchRecommendations);
// 页面切换前先清掉待执行的防抖任务，避免旧关键词操作新页面 DOM
document.addEventListener('astro:before-swap', () => {
  if (window.__searchDebounceTimer) {
    clearTimeout(window.__searchDebounceTimer);
    window.__searchDebounceTimer = null;
  }
});

// 空状态里的引导链接：先关闭搜索弹窗再跟随导航
if (!window.__searchCloseLinkBound) {
  window.__searchCloseLinkBound = true;
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof HTMLElement && target.closest('[data-search-close]')) {
      window.__closeSearchModal?.();
    }
  });
}
</script>


<style is:global>
mark {
  background-color: #ffeb3b;
  color: var(--link-color);
  padding: 0 2px;
  font-weight: 600;
}

.search-suggestion-chip {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--border-color);
  border-radius: 999px;
  background: color-mix(in srgb, var(--bg-color) 88%, transparent);
  color: var(--text-color);
  padding: 0.35rem 0.7rem;
