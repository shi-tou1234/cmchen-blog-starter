---
import type { BlogEntryWithLocaleStatus } from '@/types/content';
import { getRelativeLocaleUrl } from '@utils/url-utils';

interface Props {
  language: string;
  category: string;
  posts: BlogEntryWithLocaleStatus[];
  categoryPageUrl: string;
}

const { language, category, posts, categoryPageUrl } = Astro.props;
const panelTitle = language === 'zh-cn' ? '同分类文章' : 'More in this category';
// R1：文末紧凑列表只展示实际条数，链接统一为「查看同类全部」
const viewAllText = language === 'zh-cn' ? '查看同类全部' : 'View all';
---

<aside class="post-category-nav-root" aria-label={panelTitle}>
  <div class="post-category-nav-panel">
    <div class="post-category-nav-panel__head">
      <h2 class="post-category-nav-panel__title">{panelTitle}</h2>
      <a href={categoryPageUrl} class="post-category-nav-panel__all">{viewAllText} <span aria-hidden="true">↗</span></a>
    </div>
    <p class="post-category-nav-panel__category">{category}</p>
    <ol class="post-category-nav-list">
      {
        posts.map((post) => (
          <li class="post-category-nav-item">
            <a href={getRelativeLocaleUrl(language, `/blog/${post.id}`)}>{post.data.title}</a>
          </li>
        ))
      }
    </ol>
  </div>
</aside>

<style is:global>
/* R1：从左侧栏移到文末、评论前；紧凑列表，不再是有高度限制的滚动面板 */
.post-category-nav-root {
  width: 100%;
  margin: 40px 0 0;
}

.post-category-nav-panel {
  width: 100%;
  border-top: 1px solid var(--border-color);
  padding-top: 24px;
  background: transparent;
  border-radius: 0;
  box-shadow: none;
  overflow: visible;
  font-family: var(--font-sans);
}

.post-category-nav-panel__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  padding: 0;
}

.post-category-nav-panel__title {
  margin: 0;
  color: var(--text-color);
  font-family: var(--font-sans);
  font-size: 15px;
  font-weight: 700;
}

.post-category-nav-panel__all {
  flex-shrink: 0;
  color: var(--link-color);
  font-size: 12px;
  text-decoration: none;
}

.post-category-nav-panel__all:hover {
  text-decoration: underline;
}

.post-category-nav-panel__category {
  margin: 0;
  padding: 4px 0 12px;
  border: 0;
  color: var(--cover-subtitle-color);
  font-size: 11px;
}

.post-category-nav-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0;
  max-height: none;
  overflow: visible;
}

.post-category-nav-item a {
  display: flex;
  align-items: baseline;
  gap: 10px;
  padding: 10px 0;
  border-bottom: 1px solid var(--border-color);
  border-radius: 0;
  color: var(--text-color);
  font-family: var(--font-sans);
  font-size: 13px;
  line-height: 1.6;
  text-decoration: none;
  transition: color 0.2s ease;
}

.post-category-nav-item a::before {
  content: '';
  flex-shrink: 0;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--border-color);
}

.post-category-nav-item a:hover {
  background: transparent;
  color: var(--link-color);
  transform: none;
}

.post-category-nav-item a:focus-visible {
  outline: 2px solid var(--link-color);
  outline-offset: 2px;
}
</style>
