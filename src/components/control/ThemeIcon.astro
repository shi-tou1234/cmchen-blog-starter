---
const className = Astro.props.class;
import { Icon } from "astro-icon/components";
---

<button id="themeToggle" title="切换明暗模式" class={className}>
    <Icon name="material-symbols:dark-mode-outline-rounded" class="moon w-5 h-5"/>
    <Icon name="material-symbols:wb-sunny-outline-rounded" class="sun w-5 h-5"/>
    <Icon name="material-symbols:radio-button-partial-outline" class="system w-5 h-5"/>
</button>

<script is:inline>
if (typeof window !== 'undefined') {
  const THEME_MEDIA_QUERY = '(prefers-color-scheme: dark)';

  // 移动端自绘揭示依赖 CSS mask（个别旧 WebView 不支持）；不支持时退化为直接切换
  const MASK_SUPPORT = (() => {
    try {
      const maskVal = 'radial-gradient(circle, #000 0, transparent 0)';
      return typeof CSS !== 'undefined' && CSS.supports
        ? CSS.supports('mask-image', maskVal) || CSS.supports('-webkit-mask-image', maskVal)
        : true;
    } catch (_e) {
      return true;
    }
  })();

  function initThemeToggle() {
    const htmlRoot = document.querySelector('html');
    const themeToggle = document.getElementById('themeToggle');

    const getTheme = () => {
      var localStorageTheme = null;
      try {
        localStorageTheme = localStorage?.getItem("theme") ?? '';
      } catch (_error) {
        localStorageTheme = '';
      }
      if (['dark', 'light', 'system'].includes(localStorageTheme)) {
        return localStorageTheme;
      }
      return 'system';
    };

    const setTheme = (themeSet) => {
      htmlRoot.classList.toggle('system-theme', themeSet === 'system');
      // 始终显式设置 data-theme（亮色也设成 light），避免删属性导致部分样式失效
      const resolved = themeSet === 'system'
        ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
        : themeSet;
      htmlRoot.setAttribute('data-theme', resolved);
      try {
        window.localStorage.setItem('theme', themeSet);
      } catch (_error) {
        // 忽略无痕模式等导致的存储写入失败
      }
    };

    // 系统主题变化监听器
    const handleSystemThemeChange = (e) => {
      if (htmlRoot.classList.contains('system-theme')) {
        htmlRoot.setAttribute('data-theme', e.matches ? 'dark' : 'light');
      }
    };

    const mediaQuery = window.matchMedia(THEME_MEDIA_QUERY);
    const oldSystemThemeChangeHandler = window.__themeSystemThemeChangeHandler;
    if (oldSystemThemeChangeHandler) {
      mediaQuery.removeEventListener('change', oldSystemThemeChangeHandler);
    }
    mediaQuery.addEventListener('change', handleSystemThemeChange);
    window.__themeSystemThemeChangeHandler = handleSystemThemeChange;

    // ===== 圆形揭示动画（View Transitions，学习自 clay-blog）=====
    // 点击切换后，新主题以按钮中心为圆心作圆形扩散覆盖全屏
    const motionOK = window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

    // 运行时注入揭示关键帧的样式容器（跨路由复用同一个元素）
    const themeRevealStyle = document.getElementById('theme-reveal-style') ?? (() => {
      const styleEl = document.createElement('style');
      styleEl.id = 'theme-reveal-style';
      document.head.append(styleEl);
      return styleEl;
    })();

    let themeSwitching = false;
    let themeAnimTimer;

    // ===== 移动端自绘圆形揭示（不依赖浏览器快照）=====
    // 触屏设备上 startViewTransition 的快照机制不稳定（偶发缺字、甚至冻结页面吞掉点击），
    // 改为：克隆当前页面盖在最上层（旧主题），遮罩开一个从按钮位置扩散的圆洞，
    // 露出下面已切换好的真实页面。全程真实 DOM（文字必定可见），
    // 覆盖层 pointer-events:none，动画期间点击照常穿透到真实页面
    const showMobileReveal = (nextTheme) => {
      themeSwitching = true;
      htmlRoot.classList.add('theme-switching');

      const rect = themeToggle.getBoundingClientRect();
      const x = rect.left + rect.width / 2;
      const y = rect.top + rect.height / 2;
      const maxR =
        Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y),
        ) + 20;
      const mask = (r) =>
        `radial-gradient(circle ${r}px at ${x}px ${y}px, transparent 0, #000 1.5px)`;

      const overlay = document.createElement('div');
      overlay.id = 'theme-reveal-overlay';
      const scrollBox = document.createElement('div');
      scrollBox.style.cssText =
        'position:absolute;inset:0;overflow-y:auto;scrollbar-width:none;-ms-overflow-style:none;overscroll-behavior:contain;';
      const clone = document.body.cloneNode(true);
      // 只留纯视觉副本：移除脚本/样式/外链/嵌入/媒体，避免重复请求与重播
      clone.querySelectorAll('script,link,style,iframe,audio,video,canvas').forEach((el) => el.remove());
      clone.setAttribute('aria-hidden', 'true');
      clone.setAttribute('inert', '');
      // 把旧主题钉在覆盖层：内联一份旧 CSS 变量值，data-theme 属性兜底直接取色规则
      overlay.setAttribute('data-theme', htmlRoot.getAttribute('data-theme'));
      const cs = getComputedStyle(document.documentElement);
      for (const prop of cs) {
        if (prop.startsWith('--')) {
          overlay.style.setProperty(prop, cs.getPropertyValue(prop).trim());
        }
      }
      scrollBox.appendChild(clone);
      overlay.appendChild(scrollBox);
      document.body.appendChild(overlay);

      themeRevealStyle.textContent = `
#theme-reveal-overlay {
  position: fixed; inset: 0; z-index: 99990;
  pointer-events: none; overflow: hidden;
  animation: theme-reveal-mask 0.52s linear forwards;
}
@keyframes theme-reveal-mask {
  from { mask-image: ${mask(6)}; -webkit-mask-image: ${mask(6)}; }
  to   { mask-image: ${mask(maxR)}; -webkit-mask-image: ${mask(maxR)}; }
}`;
      // 强制布局：克隆按旧主题完成定位后再同步滚动位置
      void overlay.offsetHeight;
      scrollBox.scrollTop = window.scrollY;
      // 覆盖层就位后才切换真实页面主题：首个可见帧即为旧页面 + 按钮处小圆洞
      setTheme(nextTheme);

      const cleanup = () => {
        if (!overlay.isConnected) return;
        overlay.remove();
        htmlRoot.classList.remove('theme-switching');
        themeSwitching = false;
      };
      overlay.addEventListener('animationend', cleanup, { once: true });
      window.setTimeout(cleanup, 800);
    };

    const handleToggleClick = () => {
      if (themeSwitching) return;
      const isCurrentlyDark = htmlRoot.getAttribute('data-theme') === 'dark';
      const nextTheme = isCurrentlyDark ? 'light' : 'dark';

      // 触屏设备走自绘揭示；正在 Astro 路由过渡时不打扰
      if (
        motionOK &&
        window.matchMedia('(pointer: coarse)').matches &&
        MASK_SUPPORT &&
        !htmlRoot.hasAttribute('data-astro-transition')
      ) {
        showMobileReveal(nextTheme);
        return;
      }

      // 桌面端/支持快照的浏览器：View Transitions 圆形揭示
      if (
        motionOK &&
        document.startViewTransition &&
        !htmlRoot.hasAttribute('data-astro-transition')
      ) {
        const rect = themeToggle.getBoundingClientRect();
        const x = rect.left + rect.width / 2;
        const y = rect.top + rect.height / 2;
        const radius =
          Math.hypot(
            Math.max(x, window.innerWidth - x),
            Math.max(y, window.innerHeight - y),
          ) + 20;
        const xPercent = (x / window.innerWidth) * 100;
        const yPercent = (y / window.innerHeight) * 100;
        // CSS 中 circle() 的百分比半径相对 hypot(宽,高)/sqrt(2) 解析；
        // 用百分比而非 px，避免高 DPR 屏幕上快照按设备像素栅格化导致半径缩水
        const radiusReference =
          Math.hypot(window.innerWidth, window.innerHeight) / Math.SQRT2;
        const radiusPercent = (radius / radiusReference) * 100;

        themeSwitching = true;
        themeRevealStyle.textContent = `@keyframes theme-reveal { from { clip-path: circle(0% at ${xPercent.toFixed(4)}% ${yPercent.toFixed(4)}%); } to { clip-path: circle(${radiusPercent.toFixed(4)}% at ${xPercent.toFixed(4)}% ${yPercent.toFixed(4)}%); } }`;
        htmlRoot.classList.add('theme-vt');
        const vt = document.startViewTransition(() => setTheme(nextTheme));
        vt.finished
          .catch(() => {})
          .finally(() => {
            themeSwitching = false;
            htmlRoot.classList.remove('theme-vt');
          });
        return;
      }

      // 降级方案：直接切换，辅以轻微的整体沉降动画提示变化
      setTheme(nextTheme);
      if (motionOK) {
        htmlRoot.classList.remove('theme-anim');
        void htmlRoot.offsetWidth;
        htmlRoot.classList.add('theme-anim');
        window.clearTimeout(themeAnimTimer);
        themeAnimTimer = window.setTimeout(() => htmlRoot.classList.remove('theme-anim'), 400);
      }
    };

    if (themeToggle) {
      themeToggle.onclick = handleToggleClick;
    }

    setTheme(getTheme());
  }

  document.addEventListener('astro:page-load', initThemeToggle);
  document.addEventListener('astro:after-swap', initThemeToggle);
}
</script>


<style>
    #themeToggle .moon {
        display: none;
    }
    
    #themeToggle .sun {
        display: none;
    }
    
    #themeToggle .system {
        display: none;
    }
    
    #themeToggle .sun {
        display: inline-block;
    }
    
    html[data-theme="dark"] #themeToggle .moon {
        display: inline-block;
    }
    
    html[data-theme="dark"] #themeToggle .sun {
        display: none;
    }
    
    html.system-theme #themeToggle .system {
        display: inline-block;
    }
    
    html.system-theme #themeToggle .sun,
    html.system-theme #themeToggle .moon {
        display: none;
    }
    
</style>