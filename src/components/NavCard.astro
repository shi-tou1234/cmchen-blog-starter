---
import { Icon } from "astro-icon/components";
import { hashString } from "@utils/hash";

export interface NavCardItem {
  name: string;
  url: string;
  icon: string;
  description: string;
  color?: string;
}

interface Props {
  item: NavCardItem;
}

function generateGradient(url: string): string {
  const h = hashString(url);
  const hue1 = h % 360;
  const hue2 = (hue1 + 40 + (h % 60)) % 360;
  const sat = 35 + (h % 25);
  const light1 = 40 + (h % 15);
  const light2 = 35 + ((h >> 4) % 15);
  return `linear-gradient(-45deg, hsl(${hue1}, ${sat}%, ${light1}%) 0%, hsl(${hue2}, ${sat}%, ${light2}%) 100%)`;
}

const { item } = Astro.props;
const gradient = item.color || generateGradient(item.url);
---

<a
  href={item.url}
  target="_blank"
  rel="noopener noreferrer"
  class="nav-card"
  style={`background: ${gradient}`}
>
  <span class="nav-card-icon">
    <Icon name={item.icon} size={48} />
  </span>
  <span class="nav-card-label">{item.name}</span>
  <p class="nav-card__description">{item.description}</p>
</a>

<style is:global>
  .nav-card {
    position: relative;
    width: 300px;
    height: 200px;
    border-radius: var(--radius-card);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    overflow: hidden;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1), box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    text-decoration: none;
    cursor: pointer;
  }

  .nav-card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.15));
  }

  .nav-card-label {
    font-size: 1.1rem;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }

  /* 描述常态可见（单行 line-clamp），触屏与键盘用户也能看到 */
  .nav-card__description {
    margin: 0;
    padding: 0 1.25rem;
    max-width: 100%;
    font-size: 0.85rem;
    line-height: 1.45;
    text-align: center;
    color: rgba(255, 255, 255, 0.88);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* 悬停/键盘聚焦：轻抬升 + 主题化阴影，不再整卡翻转 */
  .nav-card:hover,
  .nav-card:focus-visible {
    transform: translateY(-6px) scale(1.02);
    box-shadow: var(--shadow-card-hover);
  }

  /* 触屏设备没有 hover：保持静止 */
  @media (hover: none) {
    .nav-card:hover {
      transform: none;
      box-shadow: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-card {
      transition: none;
    }
    .nav-card:hover,
    .nav-card:focus-visible {
      transform: none;
    }
  }

  @media (max-width: 640px) {
    .nav-card {
      width: 100%;
      max-width: 300px;
      height: 180px;
    }
  }
</style>
